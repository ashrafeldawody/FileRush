<Window x:Class="FileRush.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FileRush.App.ViewModels"
        Title="File Rush - Download Manager"
        Width="1100" Height="650" MinWidth="760" MinHeight="420"
        Background="{StaticResource WindowBackground}"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{x:Static ApplicationCommands.New}" />
        <KeyBinding Key="Delete" Command="{x:Static ApplicationCommands.Delete}" />
        <KeyBinding Key="Enter" Modifiers="Alt" Command="{x:Static ApplicationCommands.Properties}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.New}" Executed="AddUrl_Click" />
        <CommandBinding Command="{x:Static ApplicationCommands.Delete}" Executed="Delete_Click" />
        <CommandBinding Command="{x:Static ApplicationCommands.Properties}" Executed="Properties_Click" />
    </Window.CommandBindings>
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="{StaticResource WindowBackground}">
            <MenuItem Header="_Tasks">
                <MenuItem Header="Add _new download..." InputGestureText="Ctrl+N" Click="AddUrl_Click" />
                <MenuItem Header="Add batch download from _clipboard" Click="BatchFromClipboard_Click" />
                <MenuItem Header="Add batch download with _wildcards..." Click="BatchWildcards_Click" />
                <MenuItem Header="Run site _grabber..." Click="Grabber_Click" />
                <Separator />
                <MenuItem Header="_Import">
                    <MenuItem Header="From text file (list of URLs)..." Click="ImportText_Click" />
                    <MenuItem Header="From File Rush export file..." Click="ImportJson_Click" />
                </MenuItem>
                <MenuItem Header="_Export">
                    <MenuItem Header="To text file (list of URLs)..." Click="ExportText_Click" />
                    <MenuItem Header="To File Rush export file..." Click="ExportJson_Click" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Delete completed downloads" Click="DeleteCompleted_Click" />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_File">
                <MenuItem Header="_Resume download" Click="Resume_Click" />
                <MenuItem Header="_Stop download" Click="Stop_Click" />
                <MenuItem Header="Stop _all downloads" Click="StopAll_Click" />
                <Separator />
                <MenuItem Header="Open" Click="Open_Click" />
                <MenuItem Header="Open with..." Click="OpenWith_Click" />
                <MenuItem Header="Open folder" Click="OpenFolder_Click" />
                <Separator />
                <MenuItem Header="_Delete" InputGestureText="Del" Click="Delete_Click" />
                <MenuItem Header="Delete all _completed" Click="DeleteCompleted_Click" />
                <MenuItem Header="Move to..." Click="MoveTo_Click" />
                <MenuItem Header="Refresh download address..." Click="RefreshAddress_Click" />
                <MenuItem Header="_Properties" InputGestureText="Alt+Enter" Click="Properties_Click" />
            </MenuItem>
            <MenuItem Header="_Downloads">
                <MenuItem Header="_Options..." Click="Options_Click" />
                <MenuItem Header="_Scheduler..." Click="Scheduler_Click" />
                <Separator />
                <MenuItem x:Name="StartQueueMenu" Header="Start queue" />
                <MenuItem x:Name="StopQueueMenu" Header="Stop queue" />
                <Separator />
                <MenuItem Header="Speed limiter">
                    <MenuItem x:Name="SpeedLimiterOnMenu" Header="Turn on" Click="SpeedLimiterOn_Click" />
                    <MenuItem x:Name="SpeedLimiterOffMenu" Header="Turn off" Click="SpeedLimiterOff_Click" />
                    <MenuItem Header="Settings..." Click="SpeedLimiterSettings_Click" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Resume all downloads" Click="ResumeAll_Click" />
                <MenuItem Header="Stop all downloads" Click="StopAll_Click" />
                <Separator />
                <MenuItem x:Name="ShutdownWhenDoneMenu" Header="Turn off computer when done" IsCheckable="True" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="CategoriesPaneMenu" Header="Categories pane" IsCheckable="True" IsChecked="True" Click="CategoriesPane_Click" />
                <MenuItem x:Name="LargeIconsMenu" Header="Large toolbar icons" IsCheckable="True" IsChecked="True" Click="LargeIcons_Click" />
                <MenuItem x:Name="ColumnsMenu" Header="Columns" />
                <Separator />
                <MenuItem Header="Language" IsEnabled="False" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Contents" Click="Help_Click" />
                <MenuItem Header="Check for updates" IsEnabled="False" />
                <Separator />
                <MenuItem Header="_About File Rush..." Click="About_Click" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Background="{StaticResource ToolbarBackground}" BorderBrush="{StaticResource ToolbarBorder}" BorderThickness="0,1,0,1" Padding="4,2">
            <StackPanel x:Name="Toolbar" Orientation="Horizontal">
                <Button x:Name="AddUrlButton" Style="{StaticResource ToolbarButton}" Click="AddUrl_Click" ToolTip="Add a new download (Ctrl+N)">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE710;" Foreground="#2F7DD1" />
                        <TextBlock Style="{StaticResource ToolbarLabel}" Text="Add URL" />
                    </StackPanel>
                </Button>
                <Button x:Name="ResumeButton" Style="{StaticResource ToolbarButton}" Click="Resume_Click" ToolTip="Resume the selected download">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE768;" Foreground="#2E9E3F" />
                        <TextBlock Style="{StaticResource ToolbarLabel}" Text="Resume" />
                    </StackPanel>
                </Button>
                <Button x:Name="StopButton" Style="{StaticResource ToolbarButton}" Click="Stop_Click" ToolTip="Stop the selected download">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE71A;" Foreground="#D9342B" />
                        <TextBlock Style="{StaticResource ToolbarLabel}" Text="Stop" />
                    </StackPanel>
                </Button>
                <Button x:Name="StopAllButton" Style="{StaticResource ToolbarButton}" Click="StopAll_Click" ToolTip="Stop all downloads">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE8D8;" Foreground="#B42318" />
                        <TextBlock Style="{StaticResource ToolbarLabel}" Text="Stop All" />
                    </StackPanel>
                </Button>
                <Button x:Name="DeleteButton" Style="{StaticResource ToolbarButton}" Click="Delete_Click" ToolTip="Delete the selected downloads">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE74D;" Foreground="#5B6B7A" />
                        <TextBlock Style="{StaticResource ToolbarLabel}" Text="Delete" />
                    </StackPanel>
                </Button>
                <Button x:Name="DeleteCompletedButton" Style="{StaticResource ToolbarButton}" Click="DeleteCompleted_Click" ToolTip="Delete all completed downloads from the list">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE894;" Foreground="#7A5B3A" />
                        <TextBlock Style="{StaticResource ToolbarLabel}" Text="Delete Completed" />
                    </StackPanel>
                </Button>
                <Border Width="1" Background="{StaticResource ToolbarBorder}" Margin="4,6" />
                <Button Style="{StaticResource ToolbarButton}" Click="Options_Click" ToolTip="Options">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE713;" Foreground="#4B5563" />
                        <TextBlock Style="{StaticResource ToolbarLabel}" Text="Options" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Click="Scheduler_Click" ToolTip="Scheduler and queues">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE787;" Foreground="#C2410C" />
                        <TextBlock Style="{StaticResource ToolbarLabel}" Text="Scheduler" />
                    </StackPanel>
                </Button>
                <Button x:Name="StartQueueButton" Style="{StaticResource ToolbarButton}" Click="StartQueue_Click" ToolTip="Start the main download queue">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE9F5;" Foreground="#2E9E3F" />
                        <TextBlock Style="{StaticResource ToolbarLabel}" Text="Start Queue" />
                    </StackPanel>
                </Button>
                <Button x:Name="StopQueueButton" Style="{StaticResource ToolbarButton}" Click="StopQueue_Click" ToolTip="Stop the main download queue">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE9F6;" Foreground="#D9342B" />
                        <TextBlock Style="{StaticResource ToolbarLabel}" Text="Stop Queue" />
                    </StackPanel>
                </Button>
                <Border Width="1" Background="{StaticResource ToolbarBorder}" Margin="4,6" />
                <Button Style="{StaticResource ToolbarButton}" Click="Grabber_Click" ToolTip="Site grabber">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE774;" Foreground="#0E7490" />
                        <TextBlock Style="{StaticResource ToolbarLabel}" Text="Grabber" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Click="About_Click" ToolTip="About File Rush">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE946;" Foreground="#2563EB" />
                        <TextBlock Style="{StaticResource ToolbarLabel}" Text="Info" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource WindowBackground}">
            <StatusBarItem>
                <TextBlock x:Name="StatusCountText" Text="0 downloads" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="StatusSpeedText" Text="" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="StatusLimiterText" Text="Speed limiter: off" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="StatusClipboardText" Text="Clipboard monitoring: on" Foreground="#6B7280" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="210" MinWidth="120" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TreeView x:Name="CategoryTree" Grid.Column="0" ItemsSource="{Binding Nodes}" BorderThickness="0,0,1,0" SelectedItemChanged="CategoryTree_SelectedItemChanged" Padding="2">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type vm:CategoryNode}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Style="{StaticResource TreeIcon}" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
                <TreeView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Add category..." Click="AddCategory_Click" />
                        <MenuItem Header="Edit category..." Click="EditCategory_Click" />
                        <MenuItem Header="Delete category" Click="DeleteCategory_Click" />
                        <Separator />
                        <MenuItem Header="Add queue..." Click="AddQueue_Click" />
                        <MenuItem Header="Start queue" Click="StartSelectedQueue_Click" />
                        <MenuItem Header="Stop queue" Click="StopSelectedQueue_Click" />
                        <MenuItem Header="Delete queue" Click="DeleteQueue_Click" />
                    </ContextMenu>
                </TreeView.ContextMenu>
            </TreeView>
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{StaticResource WindowBackground}" />
            <ListView x:Name="DownloadList" Grid.Column="2" ItemsSource="{Binding View}" BorderThickness="0"
                      SelectionMode="Extended" ItemContainerStyle="{StaticResource DownloadRow}"
                      MouseDoubleClick="DownloadList_MouseDoubleClick" SelectionChanged="DownloadList_SelectionChanged"
                      GridViewColumnHeader.Click="ColumnHeader_Click" VirtualizingPanel.IsVirtualizing="True">
                <ListView.View>
                    <GridView x:Name="DownloadGrid" ColumnHeaderContainerStyle="{StaticResource ListHeader}">
                        <GridViewColumn x:Name="FileNameColumn" Header="File Name" Width="300">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding FileName, Converter={StaticResource FileIcon}}" Width="16" Height="16" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="QueueColumn" Header="Q" Width="26" DisplayMemberBinding="{Binding IsInQueue, Converter={StaticResource QueueMark}}" />
                        <GridViewColumn x:Name="SizeColumn" Header="Size" Width="85" DisplayMemberBinding="{Binding TotalSize, Converter={StaticResource Bytes}}" />
                        <GridViewColumn x:Name="StatusColumn" Header="Status" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="TimeLeftColumn" Header="Time left" Width="90" DisplayMemberBinding="{Binding TimeLeft, Converter={StaticResource TimeLeft}}" />
                        <GridViewColumn x:Name="SpeedColumn" Header="Transfer rate" Width="100" DisplayMemberBinding="{Binding Speed, Converter={StaticResource Speed}}" />
                        <GridViewColumn x:Name="LastTryColumn" Header="Last Try Date" Width="130" DisplayMemberBinding="{Binding LastTryAt, Converter={StaticResource Date}}" />
                        <GridViewColumn x:Name="DescriptionColumn" Header="Description" Width="200" DisplayMemberBinding="{Binding Description}" />
                    </GridView>
                </ListView.View>
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open" Click="Open_Click" FontWeight="Bold" />
                        <MenuItem Header="Open with..." Click="OpenWith_Click" />
                        <MenuItem Header="Open folder" Click="OpenFolder_Click" />
                        <Separator />
                        <MenuItem Header="Resume download" Click="Resume_Click" />
                        <MenuItem Header="Stop download" Click="Stop_Click" />
                        <MenuItem Header="Show progress" Click="ShowProgress_Click" />
                        <MenuItem Header="Refresh download address..." Click="RefreshAddress_Click" />
                        <Separator />
                        <MenuItem x:Name="MoveToQueueMenu" Header="Move to queue" />
                        <MenuItem Header="Delete from queue" Click="DeleteFromQueue_Click" />
                        <Separator />
                        <MenuItem Header="Copy URL" Click="CopyUrl_Click" />
                        <MenuItem Header="Move to..." Click="MoveTo_Click" />
                        <MenuItem Header="Delete" Click="Delete_Click" />
                        <Separator />
                        <MenuItem Header="Properties" Click="Properties_Click" />
                    </ContextMenu>
                </ListView.ContextMenu>
            </ListView>
        </Grid>
    </DockPanel>
</Window>
