<Window x:Class="FileRush.App.Dialogs.GrabberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Site Grabber" Width="700" Height="520" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackground}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Start page:" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Column="1" x:Name="UrlBox" Style="{StaticResource FieldBox}" />
        </Grid>
        <Grid Grid.Row="1" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="File types:" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Column="1" x:Name="TypesBox" Style="{StaticResource FieldBox}" Text="jpg jpeg png gif webp zip rar 7z pdf mp3 mp4 mkv exe msi" />
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="Explore depth:" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="DepthBox" Width="60" Height="24" SelectedIndex="1">
                <ComboBoxItem Content="0" />
                <ComboBoxItem Content="1" />
                <ComboBoxItem Content="2" />
                <ComboBoxItem Content="3" />
                <ComboBoxItem Content="4" />
            </ComboBox>
            <TextBlock Text="Max pages:" Style="{StaticResource FieldLabel}" Margin="16,0,10,0" />
            <TextBox x:Name="MaxPagesBox" Width="60" Style="{StaticResource FieldBox}" Text="200" />
            <CheckBox x:Name="SameHostCheck" Content="Stay on the same site" IsChecked="True" VerticalAlignment="Center" Margin="16,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,6">
            <Button x:Name="StartButton" Content="Start" Style="{StaticResource DialogButton}" Margin="0" Click="Start_Click" />
            <Button x:Name="StopButton" Content="Stop" Style="{StaticResource DialogButton}" IsEnabled="False" Click="Stop_Click" />
            <TextBlock x:Name="ProgressText" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#374151" />
        </StackPanel>
        <ListBox Grid.Row="4" x:Name="ResultList" FontFamily="Consolas" FontSize="12" />
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="DownloadButton" Content="Download files..." Style="{StaticResource DialogButton}" IsEnabled="False" Click="Download_Click" FontWeight="SemiBold" />
            <Button Content="Close" Style="{StaticResource DialogButton}" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
