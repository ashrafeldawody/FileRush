<Window x:Class="FileRush.App.Dialogs.DeleteConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm delete" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackground}" ShowInTaskbar="False">
    <StackPanel Margin="14">
        <StackPanel Orientation="Horizontal">
            <TextBlock FontFamily="{StaticResource IconFont}" FontSize="30" Text="&#xE7BA;" Foreground="#D97706" Margin="0,0,12,0" VerticalAlignment="Top" />
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="340" />
        </StackPanel>
        <CheckBox x:Name="DeleteFileCheck" Content="Also delete the downloaded file(s) from disk" Margin="42,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Yes" Style="{StaticResource DialogButton}" IsDefault="True" Click="Yes_Click" />
            <Button Content="No" Style="{StaticResource DialogButton}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
