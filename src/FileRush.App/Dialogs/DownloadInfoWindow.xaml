<Window x:Class="FileRush.App.Dialogs.DownloadInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download File Info" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackground}" Topmost="True">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="URL:" Style="{StaticResource FieldLabel}" />
        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="UrlBox" Style="{StaticResource FieldBox}" IsReadOnly="True" Background="#F7F7F7" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Category:" Style="{StaticResource FieldLabel}" />
        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CategoryBox" Height="24" Margin="0,3" HorizontalAlignment="Left" MinWidth="200" SelectionChanged="CategoryBox_SelectionChanged" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Save As:" Style="{StaticResource FieldLabel}" />
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="SaveAsBox" Style="{StaticResource FieldBox}" TextChanged="SaveAsBox_TextChanged" />
        <Button Grid.Row="2" Grid.Column="2" Content="..." Width="32" Height="24" Margin="6,3,0,3" Click="Browse_Click" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Description:" Style="{StaticResource FieldLabel}" />
        <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="DescriptionBox" Style="{StaticResource FieldBox}" />

        <CheckBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="RememberPathCheck" Content="Remember this path for this category" Margin="0,6,0,0" />

        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="File size:" FontWeight="SemiBold" Margin="0,0,8,0" />
            <TextBlock x:Name="SizeText" Text="Getting file info..." Foreground="#374151" />
            <TextBlock x:Name="ResumeText" Text="" Foreground="#6B7280" Margin="18,0,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="LaterButton" Content="Download Later" Style="{StaticResource DialogButton}" Click="Later_Click">
                <Button.ContextMenu>
                    <ContextMenu x:Name="QueueMenu" />
                </Button.ContextMenu>
            </Button>
            <Button Content="Start Download" Style="{StaticResource DialogButton}" IsDefault="True" Click="Start_Click" FontWeight="SemiBold" />
            <Button Content="Cancel" Style="{StaticResource DialogButton}" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
