<Window x:Class="FileRush.App.Dialogs.UrlListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add batch download" Width="720" Height="520" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackground}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock x:Name="CountText" VerticalAlignment="Center" />
            <Button Content="Select all" Margin="16,0,0,0" Padding="8,2" Click="SelectAll_Click" />
            <Button Content="Select none" Margin="6,0,0,0" Padding="8,2" Click="SelectNone_Click" />
        </StackPanel>
        <ListView Grid.Row="1" x:Name="UrlList">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="34">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="File" Width="200" DisplayMemberBinding="{Binding FileName}" />
                    <GridViewColumn Header="URL" Width="430" DisplayMemberBinding="{Binding Url}" />
                </GridView>
            </ListView.View>
        </ListView>
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Category:" Style="{StaticResource FieldLabel}" />
            <ComboBox Grid.Column="1" x:Name="CategoryBox" Width="150" Height="24" SelectionChanged="CategoryBox_SelectionChanged" />
            <TextBlock Grid.Column="2" Text="Save to:" Style="{StaticResource FieldLabel}" Margin="16,0,10,0" />
            <TextBox Grid.Column="3" x:Name="FolderBox" Style="{StaticResource FieldBox}" />
            <Button Grid.Column="4" Content="..." Width="32" Height="24" Margin="6,0,0,0" Click="Browse_Click" />
        </Grid>
        <CheckBox Grid.Row="3" x:Name="AutoCategoryCheck" Content="Put each file in the category matching its type (uses the category folder)" IsChecked="True" Margin="0,8,0,0" Checked="AutoCategory_Changed" Unchecked="AutoCategory_Changed" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Download now" Style="{StaticResource DialogButton}" IsDefault="True" Click="Now_Click" FontWeight="SemiBold" />
            <Button Content="Add to main queue" Style="{StaticResource DialogButton}" Click="Later_Click" />
            <Button Content="Cancel" Style="{StaticResource DialogButton}" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
