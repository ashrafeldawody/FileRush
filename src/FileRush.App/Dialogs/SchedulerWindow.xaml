<Window x:Class="FileRush.App.Dialogs.SchedulerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scheduler" Width="760" Height="520" MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackground}">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Queues:" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ListBox Grid.Row="1" x:Name="QueueList" SelectionChanged="QueueList_SelectionChanged" DisplayMemberPath="Name" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="New queue" Padding="8,2" Click="NewQueue_Click" />
                <Button Content="Delete" Padding="8,2" Margin="6,0,0,0" Click="DeleteQueue_Click" />
            </StackPanel>
        </Grid>
        <TabControl Grid.Column="1" x:Name="Tabs">
            <TabItem Header="Files in the queue">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListView x:Name="FilesList" SelectionMode="Extended">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="File name" Width="240" DisplayMemberBinding="{Binding FileName}" />
                                <GridViewColumn Header="Size" Width="80" DisplayMemberBinding="{Binding TotalSize, Converter={StaticResource Bytes}}" />
                                <GridViewColumn Header="Status" Width="140" DisplayMemberBinding="{Binding StatusText}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Move up" Padding="8,2" Click="MoveUp_Click" />
                        <Button Content="Move down" Padding="8,2" Margin="6,0,0,0" Click="MoveDown_Click" />
                        <Button Content="Remove from queue" Padding="8,2" Margin="6,0,0,0" Click="RemoveFromQueue_Click" />
                        <Button Content="Add downloads..." Padding="8,2" Margin="6,0,0,0" Click="AddToQueue_Click" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Download" VerticalAlignment="Center" />
                        <ComboBox x:Name="ConcurrentBox" Width="60" Height="24" Margin="8,0" />
                        <TextBlock Text="files at the same time" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Schedule">
                <StackPanel Margin="10">
                    <CheckBox x:Name="StartEnabledCheck" Content="Start downloading at:" />
                    <StackPanel Orientation="Horizontal" Margin="22,4,0,0">
                        <TextBox x:Name="StartTimeBox" Width="70" Style="{StaticResource FieldBox}" ToolTip="24-hour time, for example 02:30" />
                        <TextBlock Text="(hh:mm)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#6B7280" />
                    </StackPanel>
                    <RadioButton x:Name="OnceRadio" Content="One time only, on:" Margin="22,10,0,0" />
                    <DatePicker x:Name="OnceDatePicker" Width="160" HorizontalAlignment="Left" Margin="44,4,0,0" />
                    <RadioButton x:Name="DailyRadio" Content="Periodically, on the following days:" Margin="22,10,0,0" IsChecked="True" />
                    <WrapPanel Margin="44,4,0,0">
                        <CheckBox x:Name="MonCheck" Content="Mon" Margin="0,0,10,0" />
                        <CheckBox x:Name="TueCheck" Content="Tue" Margin="0,0,10,0" />
                        <CheckBox x:Name="WedCheck" Content="Wed" Margin="0,0,10,0" />
                        <CheckBox x:Name="ThuCheck" Content="Thu" Margin="0,0,10,0" />
                        <CheckBox x:Name="FriCheck" Content="Fri" Margin="0,0,10,0" />
                        <CheckBox x:Name="SatCheck" Content="Sat" Margin="0,0,10,0" />
                        <CheckBox x:Name="SunCheck" Content="Sun" Margin="0,0,10,0" />
                    </WrapPanel>
                    <CheckBox x:Name="StopEnabledCheck" Content="Stop downloading at:" Margin="0,14,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="22,4,0,0">
                        <TextBox x:Name="StopTimeBox" Width="70" Style="{StaticResource FieldBox}" />
                        <TextBlock Text="(hh:mm)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#6B7280" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock Text="When the queue finishes:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="OnCompleteBox" Width="200" Height="24">
                            <ComboBoxItem Content="Do nothing" />
                            <ComboBoxItem Content="Exit File Rush" />
                            <ComboBoxItem Content="Turn off computer" />
                            <ComboBoxItem Content="Hibernate" />
                            <ComboBoxItem Content="Stand by (sleep)" />
                        </ComboBox>
                    </StackPanel>
                    <CheckBox x:Name="ForceCheck" Content="Force programs to close when turning off the computer" Margin="0,8,0,0" />
                    <TextBlock x:Name="NextRunText" Margin="0,14,0,0" Foreground="#4B5563" />
                </StackPanel>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="StartNowButton" Content="Start now" Style="{StaticResource DialogButton}" Click="StartNow_Click" />
            <Button x:Name="StopNowButton" Content="Stop" Style="{StaticResource DialogButton}" Click="StopNow_Click" />
            <Button Content="Apply" Style="{StaticResource DialogButton}" Click="Apply_Click" />
            <Button Content="Close" Style="{StaticResource DialogButton}" IsCancel="True" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
