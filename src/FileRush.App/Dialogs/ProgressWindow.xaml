<Window x:Class="FileRush.App.Dialogs.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FileRush.App.Controls"
        Title="Download progress" Width="620" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackground}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="URL" Style="{StaticResource FieldLabel}" Margin="0,2,16,2" />
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="UrlText" TextTrimming="CharacterEllipsis" Margin="0,2" Foreground="#1D4ED8" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Status" Style="{StaticResource FieldLabel}" Margin="0,2,16,2" />
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="StatusText" Margin="0,2" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="File size" Style="{StaticResource FieldLabel}" Margin="0,2,16,2" />
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SizeText" Margin="0,2" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Downloaded" Style="{StaticResource FieldLabel}" Margin="0,2,16,2" />
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DownloadedText" Margin="0,2" />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Transfer rate" Style="{StaticResource FieldLabel}" Margin="0,2,16,2" />
            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="SpeedText" Margin="0,2" />
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Time left" Style="{StaticResource FieldLabel}" Margin="0,2,16,2" />
            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="TimeLeftText" Margin="0,2" />
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Resume capability" Style="{StaticResource FieldLabel}" Margin="0,2,16,2" />
            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="ResumeText" Margin="0,2" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <controls:SegmentBar x:Name="Bar" Height="26" />
            <ItemsControl x:Name="Legend" Margin="0,5,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <Rectangle Width="12" Height="12" Fill="{Binding Brush}" Stroke="#6B7280" StrokeThickness="0.5" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Text}" Margin="5,0,0,0" Foreground="#374151" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border x:Name="RejectedWarning" Visibility="Collapsed" Margin="0,6,0,0" Padding="8,5" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="3">
                <TextBlock x:Name="RejectedWarningText" TextWrapping="Wrap" Foreground="#78350F" />
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="After download:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="AfterBox" Width="190" Height="24" SelectionChanged="AfterBox_SelectionChanged">
                    <ComboBoxItem Content="Do nothing" IsSelected="True" />
                    <ComboBoxItem Content="Open the file" />
                    <ComboBoxItem Content="Open the folder" />
                    <ComboBoxItem Content="Exit File Rush" />
                    <ComboBoxItem Content="Turn off computer" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="DetailsButton" Content="Show details &gt;&gt;" Style="{StaticResource DialogButton}" Click="Details_Click" />
                <Button x:Name="PauseButton" Content="Pause" Style="{StaticResource DialogButton}" Click="Pause_Click" />
                <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource DialogButton}" Click="Cancel_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" x:Name="DetailsPanel" Visibility="Collapsed" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock x:Name="ElapsedText" Foreground="#4B5563" />
                <TextBlock x:Name="ConnectionsText" Foreground="#4B5563" Margin="18,0,0,0" />
                <TextBlock x:Name="SavePathText" Foreground="#4B5563" Margin="18,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="280" />
            </StackPanel>
            <TabControl Grid.Row="1" Height="200">
                <TabItem Header="Connections">
                    <ListView x:Name="ConnectionList" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="N." Width="36" DisplayMemberBinding="{Binding Number}" />
                                <GridViewColumn Header="Adapter" Width="100" DisplayMemberBinding="{Binding Route}" />
                                <GridViewColumn Header="Part" Width="44" DisplayMemberBinding="{Binding Part}" />
                                <GridViewColumn Header="Downloaded" Width="95" DisplayMemberBinding="{Binding Downloaded, Converter={StaticResource Bytes}}" />
                                <GridViewColumn Header="Info" Width="290" DisplayMemberBinding="{Binding Info}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </TabItem>
                <TabItem Header="Parts">
                    <ListView x:Name="PartList" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Part" Width="40" DisplayMemberBinding="{Binding Number}" />
                                <GridViewColumn Header="Range" Width="170" DisplayMemberBinding="{Binding Range}" />
                                <GridViewColumn Header="Size" Width="80" DisplayMemberBinding="{Binding Size}" />
                                <GridViewColumn Header="Done" Width="60" DisplayMemberBinding="{Binding Done}" />
                                <GridViewColumn Header="Connection" Width="75" DisplayMemberBinding="{Binding Connection}" />
                                <GridViewColumn Header="Adapter" Width="135" DisplayMemberBinding="{Binding Route}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
