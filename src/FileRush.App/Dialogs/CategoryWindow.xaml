<Window x:Class="FileRush.App.Dialogs.CategoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Category" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackground}" ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Category name:" Style="{StaticResource FieldLabel}" />
        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="NameBox" Style="{StaticResource FieldBox}" />
        <TextBlock Grid.Row="1" Grid.Column="0" Text="File extensions:" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,8,10,0" />
        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ExtensionsBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,3" VerticalScrollBarVisibility="Auto" />
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Default folder:" Style="{StaticResource FieldLabel}" />
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="FolderBox" Style="{StaticResource FieldBox}" />
        <Button Grid.Row="2" Grid.Column="2" Content="..." Width="32" Height="24" Margin="6,3,0,3" Click="Browse_Click" />
        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" Style="{StaticResource DialogButton}" IsDefault="True" Click="Ok_Click" />
            <Button Content="Cancel" Style="{StaticResource DialogButton}" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
