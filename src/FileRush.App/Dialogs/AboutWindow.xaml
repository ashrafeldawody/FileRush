<Window x:Class="FileRush.App.Dialogs.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About File Rush" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackground}" ShowInTaskbar="False">
    <StackPanel Margin="18">
        <StackPanel Orientation="Horizontal">
            <Image x:Name="LogoImage" Width="48" Height="48" Margin="0,0,14,0" VerticalAlignment="Top" />
            <StackPanel>
                <TextBlock Text="File Rush" FontSize="20" FontWeight="Bold" />
                <TextBlock x:Name="VersionText" Text="Version 1.0.0" Foreground="#4B5563" />
                <TextBlock Text="A fast download manager and accelerator" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
        <TextBlock Margin="0,14,0,0" TextWrapping="Wrap"
                   Text="Multi-connection dynamic segmentation, resume of broken downloads, queues and scheduler, batch downloads with wildcards, site grabber, clipboard monitoring, speed limiter, categories, proxy and site logins." />
        <TextBlock Margin="0,10,0,0" Foreground="#6B7280" Text="Built with .NET 10 and WPF." />
        <Button Content="OK" Style="{StaticResource DialogButton}" HorizontalAlignment="Right" Margin="0,16,0,0" IsDefault="True" IsCancel="True" />
    </StackPanel>
</Window>
