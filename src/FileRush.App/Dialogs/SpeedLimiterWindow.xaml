<Window x:Class="FileRush.App.Dialogs.SpeedLimiterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Speed limiter" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackground}" ShowInTaskbar="False">
    <StackPanel Margin="14">
        <CheckBox x:Name="EnableCheck" Content="Use speed limiter" />
        <StackPanel Orientation="Horizontal" Margin="22,10,0,0">
            <TextBlock Text="Maximum download speed:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="SpeedBox" Width="80" Style="{StaticResource FieldBox}" />
            <TextBlock Text="KB/sec" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>
        <TextBlock Margin="22,8,0,0" Foreground="#6B7280" TextWrapping="Wrap" Text="The limit applies to the total speed of all active downloads." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" Style="{StaticResource DialogButton}" IsDefault="True" Click="Ok_Click" />
            <Button Content="Cancel" Style="{StaticResource DialogButton}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
