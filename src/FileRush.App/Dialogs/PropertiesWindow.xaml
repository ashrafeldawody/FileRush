<Window x:Class="FileRush.App.Dialogs.PropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download properties" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackground}" ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="File name:" Style="{StaticResource FieldLabel}" />
        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="FileNameBox" Style="{StaticResource FieldBox}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Save to:" Style="{StaticResource FieldLabel}" />
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="FolderBox" Style="{StaticResource FieldBox}" />
        <Button Grid.Row="1" Grid.Column="2" Content="..." Width="32" Height="24" Margin="6,3,0,3" Click="Browse_Click" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Address:" Style="{StaticResource FieldLabel}" />
        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="UrlBox" Style="{StaticResource FieldBox}" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Referrer:" Style="{StaticResource FieldLabel}" />
        <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ReferrerBox" Style="{StaticResource FieldBox}" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Description:" Style="{StaticResource FieldLabel}" />
        <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="DescriptionBox" Style="{StaticResource FieldBox}" />

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Category:" Style="{StaticResource FieldLabel}" />
        <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
            <ComboBox x:Name="CategoryBox" Height="24" Margin="0,3" MinWidth="180" />
            <TextBlock Text="Connections:" Style="{StaticResource FieldLabel}" Margin="20,0,8,0" />
            <ComboBox x:Name="ConnectionsBox" Height="24" Width="90" />
        </StackPanel>

        <CheckBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" x:Name="AuthCheck" Content="Use authorization" Margin="0,8,0,4" Checked="AuthCheck_Changed" Unchecked="AuthCheck_Changed" />
        <Grid Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" x:Name="AuthPanel" IsEnabled="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Login:" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Column="1" x:Name="LoginBox" Style="{StaticResource FieldBox}" />
            <TextBlock Grid.Column="2" Text="Password:" Style="{StaticResource FieldLabel}" Margin="14,0,10,0" />
            <PasswordBox Grid.Column="3" x:Name="PasswordBox" Height="24" Margin="0,3" VerticalContentAlignment="Center" />
        </Grid>

        <TextBlock Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" x:Name="InfoText" Foreground="#6B7280" Margin="0,10,0,0" TextWrapping="Wrap" />

        <StackPanel Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" Style="{StaticResource DialogButton}" IsDefault="True" Click="Ok_Click" />
            <Button Content="Cancel" Style="{StaticResource DialogButton}" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
